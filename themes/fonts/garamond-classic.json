{
  "id": "garamond-classic",
  "name": "Garamond Classic",
  "description": "Traditional, composed - EB Garamond headings with a readable sans body",
  "heading": {
    "family": "EB Garamond",
    "fallback": "Garamond, 'Times New Roman', serif",
    "weights": [
      400,
      500,
      600
    ],
    "import": "EB+Garamond:ital,wght@0,400;0,500;0,600;1,400"
  },
  "body": {
    "family": "Source Sans 3",
    "fallback": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "weights": [
      400,
      500,
      600
    ],
    "import": "Source+Sans+3:wght@400;500;600"
  },
  "sizes": {
    "text-h1-desktop": "2.5rem",
    "text-h2-desktop": "2rem",
    "text-h3-desktop": "1.5rem"
  }
}
